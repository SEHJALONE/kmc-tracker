# ─────────────────────────────────────────────
# KMC Email Server — Environment Variables
# Save this as  .env  in your kmc-tracker folder
# ─────────────────────────────────────────────

# Your Gmail address
EMAIL_USER=xcellencysehj@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# Get one at: https://myaccount.google.com/apppasswords
# You must have 2FA enabled on your Google account first
EMAIL_PASS=ivkp zgyq gnal pcfq

# Display name in the "From" field
EMAIL_FROM=KMC Tracker <xcellencysehj@gmail.com>

# Port for the email server (keep 3001 so it doesn't clash with Vite on 5173)
PORT=3001

# ─────────────────────────────────────────────
# Add this to your VITE env (same .env file is fine)
# ─────────────────────────────────────────────
VITE_EMAIL_ENDPOINT=http://localhost:3001/api/send-report
