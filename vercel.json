{
  "rewrites": [
    { "source": "/ncr", "destination": "/ncr.html" },
    { "source": "/ncr/(.*)", "destination": "/ncr.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/run-scheduled",
      "schedule": "0 7 * * *"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
